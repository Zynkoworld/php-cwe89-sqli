{"id": "flag-concat-var", "cwe": "CWE-89", "lang": "php", "expected_verdict": "FLAG", "note": "query built by concatenation of $_POST, then mysqli_query", "code": "<?php\n$id = $_POST['id'];\n$q = \"SELECT * FROM t WHERE id=\" . $id;\nmysqli_query($conn, $q);\n"}
{"id": "flag-pdo-interp", "cwe": "CWE-89", "lang": "php", "expected_verdict": "FLAG", "note": "tainted var interpolated into a PDO->query string", "code": "<?php\n$u = $_GET['u'];\n$pdo->query(\"SELECT * FROM t WHERE u='$u'\");\n"}
{"id": "flag-inline-concat", "cwe": "CWE-89", "lang": "php", "expected_verdict": "FLAG", "note": "inline $_REQUEST concatenated into mysql_query", "code": "<?php\nmysql_query(\"DELETE FROM t WHERE x='\" . $_REQUEST['x'] . \"'\");\n"}
{"id": "flag-prepare-tainted", "cwe": "CWE-89", "lang": "php", "expected_verdict": "FLAG", "note": "prepare() given a query string with concatenated user input (defeats the point)", "code": "<?php\n$c = $_GET['c'];\n$stmt = $pdo->prepare(\"SELECT * FROM t WHERE c='\" . $c . \"'\");\n$stmt->execute();\n"}
{"id": "safe-mysqli-prepare", "cwe": "CWE-89", "lang": "php", "expected_verdict": "SAFE", "note": "mysqli prepared statement with ? placeholder + bind_param", "code": "<?php\n$stmt = $conn->prepare(\"SELECT * FROM users WHERE name = ?\");\n$stmt->bind_param(\"s\", $_GET['name']);\n$stmt->execute();\n"}
{"id": "safe-pdo-named", "cwe": "CWE-89", "lang": "php", "expected_verdict": "SAFE", "note": "PDO prepared statement with :named placeholder + bindValue", "code": "<?php\n$stmt = $pdo->prepare(\"SELECT * FROM t WHERE u = :u\");\n$stmt->bindValue(\":u\", $_GET['u']);\n$stmt->execute();\n"}
{"id": "safe-constant", "cwe": "CWE-89", "lang": "php", "expected_verdict": "SAFE", "note": "fully constant query, no user input", "code": "<?php\nmysqli_query($conn, \"SELECT COUNT(*) FROM users\");\n"}
{"id": "safe-pdo-query-const", "cwe": "CWE-89", "lang": "php", "expected_verdict": "SAFE", "note": "PDO->query with a constant string", "code": "<?php\n$pdo->query(\"SELECT * FROM config\");\n"}
{"id": "safe-execute-array", "cwe": "CWE-89", "lang": "php", "expected_verdict": "SAFE", "note": "PDO prepare(? ) then execute([$_GET]) \u2014 user input as a bound parameter", "code": "<?php\n$stmt = $pdo->prepare(\"SELECT * FROM t WHERE id = ?\");\n$stmt->execute([$_GET['id']]);\n"}
